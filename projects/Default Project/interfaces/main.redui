          "style": {
            "backgroundColor": "#0b0d14",
            "borderWidth": 2,
            "borderColor": "#000",
            "fontSize": 10,
            "fontWeight": "700",
            "color": "#fff",
            "zIndex": 96
          },
          "props": {
            "variable": "player.mana",
            "maxVariable": "player.maxMana",
            "fillColor": "#3aa6e0",
            "ticks": 8
          }
        },
        {
