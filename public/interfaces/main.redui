{
  "format": "redglitch-ui",
  "formatVersion": 1,
  "resolution": {
    "w": 800,
    "h": 450
  },
  "designSystem": {
    "name": "RedGlitch Air HUD",
    "themeId": "redglitch_ops",
    "grid": 4,
    "palette": {
      "void": "#080b14",
      "panel": "rgba(14, 19, 32, 0.78)",
      "panelInner": "rgba(9, 13, 24, 0.56)",
      "scrim": "rgba(4, 7, 14, 0.60)",
      "border": "rgba(255, 77, 99, 0.42)",
      "accent": "#ff4d63",
      "gold": "#ffd670",
      "cyan": "#5eead4",
      "green": "#6ee7a8",
      "violet": "#c4b5fd",
      "ink": "#f8fafc",
      "muted": "#94a3b8",
      "barTrack": "rgba(12, 16, 28, 0.85)",
      "barText": "#ffffff",
      "textShadow": "1px 1px 0 rgba(0, 0, 0, 0.55)",
      "hp": "#fb566c",
      "mp": "#38bdf8",
      "st": "#4ade80",
      "radius": 2,
      "panelBorderWidth": 1,
      "ticks": 8,
      "panelShadow": "inset 0 1px 0 rgba(255,255,255,0.09), 2px 2px 0 rgba(0,0,0,0.34)",
      "btnRadius": 2
    },
    "typography": {
      "fontFamily": "VT323, monospace",
      "letterSpacing": 0
    }
  },
  "screens": {
    "main_hud": {
