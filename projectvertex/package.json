{
  "name": "projectvertex",
  "version": "0.1.0",
  "private": true,
  "description": "Self-directed AI game generation pipeline built on top of Redglitch Engine.",
  "type": "commonjs",
  "main": "cli.js",
  "bin": {
    "projectvertex": "./cli.js"
  },
  "scripts": {
    "start": "npm run ui:build && node server/index.js",
    "cli": "node cli.js",
    "server": "node server/index.js",
    "test": "node --test",
    "quality:run": "node scripts/validate-run.js",
    "ui:dev": "vite --config webui/vite.config.js",
    "ui:build": "vite build --config webui/vite.config.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.6",
    "archiver": "^5.3.2",
    "dotenv": "^9.0.2"
  },
  "devDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.0.13",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
