# Copy to .env and fill in at least one provider's key. This file is only
# read locally (server/index.js, cli.js, api/index.js load it via dotenv) —
# on Vercel, set these in the project's Environment Variables settings
# instead; .env itself is gitignored and never deployed.

LLM_PROVIDER=openrouter
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

OPENCODE_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
